# Naturalista — Variables de entorno

# Copia este archivo como .env.local y llena los valores reales
# NUNCA subas .env.local a git

GOOGLE_SHEET_ID=your_spreadsheet_id_here
GOOGLE_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nTu llave privada aquí\n-----END PRIVATE KEY-----\n"

# Autenticacion de la aplicacion
AUTH_USER=tu_usuario
AUTH_PASSWORD=tu_contrasena_segura
